generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://socialuser:StrongPass!123@112.124.51.207:3306/socialdb"
}

model User {
  id                 String         @id @default(cuid())
  phone              String         @unique
  password           String
  nickname           String
  gender             Gender
  age                Int
  height             Int
  weight             Int
  hometown           String
  currentCity        String
  incomeProofStatus  String         @default("PENDING")
  hobbies            String
  partnerExpectation String
  avatarUrl          String?
  photoUrls          String
  membershipType     MembershipType @default(FREE)
  membershipExpireAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  maleUnlocks        MaleUnlock[]
  sentMessages       ChatMessage[]  @relation("ChatMessageSender")
  recvMessages       ChatMessage[]  @relation("ChatMessageReceiver")
}

model MatchSession {
  id                String   @id @default(cuid())
  maleUserId        String
  femaleUserId      String
  friendliness      Int      @default(0)
  roundsPlayed      Int      @default(0)
  isUnlocked        Boolean  @default(false)
  unlockPaid        Boolean  @default(false)
  startedAt         DateTime @default(now())
  lastInteractionAt DateTime @updatedAt
}

model MaleUnlock {
  id           String   @id @default(cuid())
  maleUserId   String
  femaleUserId String
  amount       Float
  createdAt    DateTime @default(now())
  maleUser     User     @relation(fields: [maleUserId], references: [id])

  @@index([maleUserId], map: "MaleUnlock_maleUserId_fkey")
}

model ChatMessage {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  text       String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  fromUser User @relation("ChatMessageSender", fields: [fromUserId], references: [id])
  toUser   User @relation("ChatMessageReceiver", fields: [toUserId], references: [id])

  @@index([fromUserId, toUserId, createdAt])
  @@index([toUserId, fromUserId, readAt])
}

enum Gender {
  MALE
  FEMALE
}

enum MembershipType {
  FREE
  MONTH
  QUARTER
  HALF_YEAR
  YEAR
}
