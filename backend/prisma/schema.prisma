generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://socialuser:StrongPass!123@112.124.51.207:3306/socialdb"
}

model User {
  id                 String         @id @default(cuid())
  phone              String         @unique
  password           String
  nickname           String
  gender             Gender         @default(MALE)
  age                Int            @default(24)
  height             Int            @default(170)
  weight             Int            @default(60)
  birthDate          DateTime?
  hometown           String         @default("")
  currentCity        String         @default("")
  income             String?
  industry           String?
  incomeProofStatus  String         @default("PENDING")
  hobbies            String         @default("")
  partnerExpectation String         @default("")
  profileCompleted   Boolean        @default(false)
  avatarUrl          String?
  photoUrls          String
  membershipType     MembershipType @default(FREE)
  membershipExpireAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  maleUnlocks        MaleUnlock[]
  sentMessages       ChatMessage[]  @relation("ChatMessageSender")
  recvMessages       ChatMessage[]  @relation("ChatMessageReceiver")
  sentFriendRequests FriendRequest[] @relation("FriendRequestSender")
  recvFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
}

model MatchSession {
  id                String   @id @default(cuid())
  maleUserId        String
  femaleUserId      String
  friendliness      Int      @default(0)
  roundsPlayed      Int      @default(0)
  isUnlocked        Boolean  @default(false)
  unlockPaid        Boolean  @default(false)
  startedAt         DateTime @default(now())
  lastInteractionAt DateTime @updatedAt
}

model MaleUnlock {
  id           String   @id @default(cuid())
  maleUserId   String
  femaleUserId String
  amount       Float
  createdAt    DateTime @default(now())
  maleUser     User     @relation(fields: [maleUserId], references: [id])

  @@index([maleUserId], map: "MaleUnlock_maleUserId_fkey")
}

model ChatMessage {
  id               String      @id @default(cuid())
  fromUserId       String
  toUserId         String
  kind             MessageKind @default(TEXT)
  text             String      @default("")
  mediaUrl         String?
  audioDurationSec Int?
  readAt           DateTime?
  createdAt        DateTime    @default(now())

  fromUser User @relation("ChatMessageSender", fields: [fromUserId], references: [id])
  toUser   User @relation("ChatMessageReceiver", fields: [toUserId], references: [id])

  @@index([fromUserId, toUserId, createdAt])
  @@index([toUserId, fromUserId, readAt])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model FriendRequest {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromUser User @relation("FriendRequestSender", fields: [fromUserId], references: [id])
  toUser   User @relation("FriendRequestReceiver", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

enum Gender {
  MALE
  FEMALE
}

enum MembershipType {
  FREE
  MONTH
  QUARTER
  HALF_YEAR
  YEAR
}

enum MessageKind {
  TEXT
  IMAGE
  AUDIO
}
