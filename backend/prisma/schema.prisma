generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://socialuser:StrongPass!123@112.124.51.207:3306/socialdb"
}

model User {
  id                 String         @id @default(cuid())
  phone              String         @unique
  password           String
  nickname           String
  gender             Gender         @default(MALE)
  age                Int            @default(24)
  height             Int            @default(170)
  weight             Int            @default(60)
  birthDate          DateTime?
  hometown           String         @default("")
  currentCity        String         @default("")
  income             String?
  industry           String?
  incomeProofStatus  String         @default("PENDING")
  hobbies            String         @default("")
  partnerExpectation String         @default("")
  profileCompleted   Boolean        @default(false)
  avatarUrl          String?          @db.VarChar(2048)
  photoUrls          String           @db.Text
  fakeRobotLibrary   FakeRobotLibrary @default(NONE)
  membershipType     MembershipType @default(FREE)
  membershipExpireAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  maleUnlocks        MaleUnlock[]
  sentMessages       ChatMessage[]  @relation("ChatMessageSender")
  recvMessages       ChatMessage[]  @relation("ChatMessageReceiver")
  sentFriendRequests FriendRequest[] @relation("FriendRequestSender")
  recvFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  werewolfRoomsOwned WerewolfRoom[] @relation("WerewolfRoomOwner")
  werewolfRoomMembers WerewolfRoomMember[]
  werewolfQueueEntries WerewolfMatchQueue[]
  tacitRoomsOwned TacitRoom[] @relation("TacitRoomOwner")
  tacitRoomMembers TacitRoomMember[]
  tacitQueueEntries TacitMatchQueue[]
  tacitAnswers TacitAnswer[]
  squareMoments     SquareMoment[]
}

model MatchSession {
  id                String   @id @default(cuid())
  maleUserId        String
  femaleUserId      String
  friendliness      Int      @default(0)
  roundsPlayed      Int      @default(0)
  isUnlocked        Boolean  @default(false)
  unlockPaid        Boolean  @default(false)
  startedAt         DateTime @default(now())
  lastInteractionAt DateTime @updatedAt
}

model MaleUnlock {
  id           String   @id @default(cuid())
  maleUserId   String
  femaleUserId String
  amount       Float
  createdAt    DateTime @default(now())
  maleUser     User     @relation(fields: [maleUserId], references: [id])

  @@index([maleUserId], map: "MaleUnlock_maleUserId_fkey")
}

model AdminAccount {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  canManageUsers Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ChatMessage {
  id               String      @id @default(cuid())
  fromUserId       String
  toUserId         String
  kind             MessageKind @default(TEXT)
  text             String      @default("")
  mediaUrl         String?
  thumbMediaUrl    String?
  audioDurationSec Int?
  readAt           DateTime?
  createdAt        DateTime    @default(now())

  fromUser User @relation("ChatMessageSender", fields: [fromUserId], references: [id])
  toUser   User @relation("ChatMessageReceiver", fields: [toUserId], references: [id])

  @@index([fromUserId, toUserId, createdAt])
  @@index([toUserId, fromUserId, readAt])
}

// 广场动态：文本 + 可选多图（imageUrls 为 JSON 字符串数组）
model SquareMoment {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.Text
  imageUrls String   @db.Text
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model FriendRequest {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromUser User @relation("FriendRequestSender", fields: [fromUserId], references: [id])
  toUser   User @relation("FriendRequestReceiver", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

model WerewolfRoom {
  id              String              @id @default(cuid())
  type            WerewolfRoomType
  status          WerewolfRoomStatus  @default(WAITING)
  ownerUserId     String
  maxSeats        Int                 @default(12)
  minStartPlayers Int                 @default(6)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  owner   User                 @relation("WerewolfRoomOwner", fields: [ownerUserId], references: [id])
  members WerewolfRoomMember[]

  @@index([ownerUserId, status])
}

model WerewolfRoomMember {
  id              String                   @id @default(cuid())
  roomId          String
  userId          String
  status          WerewolfRoomMemberStatus @default(PENDING)
  invitedByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  room WerewolfRoom @relation(fields: [roomId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([userId, status])
}

model WerewolfMatchQueue {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model TacitRoom {
  id          String          @id @default(cuid())
  type        TacitRoomType
  status      TacitRoomStatus @default(WAITING)
  ownerUserId String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner     User             @relation("TacitRoomOwner", fields: [ownerUserId], references: [id])
  members   TacitRoomMember[]
  questions TacitQuestion[]
  answers   TacitAnswer[]

  @@index([ownerUserId, status])
}

model TacitRoomMember {
  id              String                @id @default(cuid())
  roomId          String
  userId          String
  status          TacitRoomMemberStatus @default(PENDING)
  invitedByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  room    TacitRoom    @relation(fields: [roomId], references: [id])
  user    User         @relation(fields: [userId], references: [id])
  answers TacitAnswer[]

  @@unique([roomId, userId])
  @@index([userId, status])
}

model TacitQuestion {
  id        String   @id @default(cuid())
  roomId    String
  sortOrder Int
  prompt    String
  optionA   String
  optionB   String
  createdAt DateTime @default(now())

  room    TacitRoom     @relation(fields: [roomId], references: [id])
  answers TacitAnswer[]

  @@unique([roomId, sortOrder])
  @@index([roomId])
}

model TacitAnswer {
  id           String  @id @default(cuid())
  roomId       String
  questionId   String
  memberId     String
  userId       String
  choice       String
  answeredAt   DateTime @default(now())

  room     TacitRoom       @relation(fields: [roomId], references: [id])
  question TacitQuestion   @relation(fields: [questionId], references: [id])
  member   TacitRoomMember @relation(fields: [memberId], references: [id])
  user     User            @relation(fields: [userId], references: [id])

  @@unique([questionId, userId])
  @@index([roomId, questionId])
}

model TacitMatchQueue {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum FakeRobotLibrary {
  NONE
  SYSTEM
  USER
}

enum Gender {
  MALE
  FEMALE
}

enum MembershipType {
  FREE
  MONTH
  QUARTER
  HALF_YEAR
  YEAR
}

enum MessageKind {
  TEXT
  IMAGE
  AUDIO
}

enum WerewolfRoomType {
  MATCH
  FRIEND
}

enum WerewolfRoomStatus {
  WAITING
  READY
  IN_GAME
  CLOSED
}

enum WerewolfRoomMemberStatus {
  HOST
  PENDING
  ACCEPTED
  DECLINED
}

enum TacitRoomType {
  MATCH
  FRIEND
}

enum TacitRoomStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CLOSED
}

enum TacitRoomMemberStatus {
  HOST
  PENDING
  ACCEPTED
  DECLINED
}
