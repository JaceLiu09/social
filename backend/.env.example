DATABASE_URL="mysql://username:password@your-host:3306/your-db-name"

# 管理后台使用管理员账号登录（见 prisma seed 默认 admin / 123456），不再需要 ADMIN_API_SECRET。

# —— 阿里云 OSS（可选；不要把真实 Key 提交到 Git）——
# 配置完整后：管理后台 Fake 图 → fake-pictures/male|female/；聊天 → chat-history-pictures/；真人资料图 → zhenren-pictures/
# 未配置时仍写本地 backend/uploads（兼容旧部署）。
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=fake-images
# ALIYUN_OSS_REGION=oss-cn-hangzhou
# 可选：自定义 Endpoint（如 OSS 接入点），不设则使用 https://{region}.aliyuncs.com
# ALIYUN_OSS_ENDPOINT=https://oss-xxxx.oss-cn-hangzhou.oss-accesspoint.aliyuncs.com
# 若 ENDPOINT 为「接入点」域名：服务端 ali-oss 默认仍用「区域 Endpoint」签名读写（避免 SignatureDoesNotMatch）。
# 必须让 SDK 也走接入点时（不推荐，易签名失败）：ALIYUN_OSS_USE_AP_FOR_SDK=1
# 可选：CDN/自定义域直链读 URL（设置后不再使用同源代理路径）
# ALIYUN_OSS_PUBLIC_BASE_URL=https://manghe.me
#
# 浏览器访问域名（与 deploy.sh PUBLIC_SITE_URL 一致，用于分享链接等）
# PUBLIC_SITE_URL=https://manghe.me
#
# 默认：上传后返回的读地址为同源 `/oss-media/{objectKey}`，由服务端持 AK 代理 GET（Bucket 可保持私有）。
# 若仍要浏览器直访 OSS 虚拟主机 URL，设置其一：
# ALIYUN_OSS_READ_MODE=direct
# ALIYUN_OSS_USE_DIRECT_URL=1
#
# 运行时服务端只用「区域 Endpoint」签名上传（与 npm run test:oss 成功的那条一致），无需配置接入点域名。
# 使用默认 `/oss-media` 代理时，桶无需开放匿名读。
#
# npm run test:oss       — 连通性（可选接入点探测变量见 scripts/test-oss-upload.mjs）
# npm run migrate:oss-fakes — 把已有 fakem/fakef 用户库里 /uploads/ 路径迁到 OSS 并更新数据库
# npm run upload:seed-avatars-oss — 在本机把 frontend/public/avatars 传到 OSS（fake-pictures/seed-avatars/），供 App 选头像走 /oss-media
# npm run migrate:oss-urls-proxy — 把库里完整 OSS/ CDN HTTPS 媒体 URL 改成 /oss-media/...（私有桶 + 代理）
#   可先 dry-run：OSS_URL_REWRITE_DRY_RUN=1 npm run migrate:oss-urls-proxy
#   其它 CDN 域名：OSS_URL_REWRITE_EXTRA_HOSTS=img.example.com,cdn.example.com

# 聊天敏感词：默认内置词库；额外词逗号分隔追加（命中后替换为等长 *）
# SENSITIVE_WORDS_EXTRA=违禁词1,违禁词2
