DATABASE_URL="mysql://username:password@your-host:3306/your-db-name"

# 管理后台使用管理员账号登录（见 prisma seed 默认 admin / 123456），不再需要 ADMIN_API_SECRET。

# —— 阿里云 OSS（可选；不要把真实 Key 提交到 Git）——
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=fake-images
# ALIYUN_OSS_REGION=oss-cn-hangzhou
# 外网接入点，需带 https://
# ALIYUN_OSS_ENDPOINT=https://xxx.oss-cn-hangzhou.oss-accesspoint.aliyuncs.com
# 接入点域名含 oss-accesspoint 时，test:oss 会自动 sldEnable（路径含 Bucket，避免 bucket.接入点 无效 DNS）
# 接入点 + 403 签名错误时，test:oss 会默认开启 authorizationV4；也可改走经典域名： https://oss-cn-hangzhou.aliyuncs.com
# ALIYUN_OSS_SLD=0
# ALIYUN_OSS_AUTH_V4=0
# 本地探测：cd backend && npm run test:oss
# 对象前缀：chat-history-pictures/ 聊天图；fake-pictures/ 假人；zhenren-pictures/ 真人
