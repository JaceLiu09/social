.page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.intro {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.h2 {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.seg {
  display: flex;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  background: #f9fafb;
}

.seg-item.on {
  background: #111827;
  color: #fff;
}

.input {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.picker {
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.btn {
  margin-top: 16rpx;
  background: #111827;
  color: #fff;
  border-radius: 12rpx;
}

.btn.secondary {
  margin-top: 24rpx;
  background: #374151;
}

.btn.warn {
  margin-top: 24rpx;
  background: #b45309;
}

.user-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 8rpx;
}

.out {
  margin-left: auto;
  color: #2563eb;
  font-size: 26rpx;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  font-size: 26rpx;
}

.tab.on {
  border-color: #111827;
  background: #111827;
  color: #fff;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.mt {
  margin-top: 16rpx;
}

.mt-sm {
  margin-top: 8rpx;
}

.result {
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.options {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.post {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 16rpx;
}

.bb-av {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #111827;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-t {
  flex: 1;
  min-width: 60%;
}

.plans {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.toast {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 48rpx;
  background: rgba(17, 24, 39, 0.92);
  color: #fff;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  z-index: 100;
}
